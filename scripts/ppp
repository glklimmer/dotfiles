#!/usr/bin/env bash
set -euo pipefail

tmux display-message -p '#{session_name}' >/dev/null 2>&1 || {
  echo "Run this inside tmux"
  exit 1
}

top="$(tmux display-message -p '#{pane_id}')"
tmux kill-pane -a -t "$top"
tmux send-keys -t "$top" C-c 'reset' C-m

tmux split-window -v -t "$top"
bottom_left="$(tmux display-message -p '#{pane_id}')"
tmux send-keys -t "$bottom_left" C-c 'reset' C-m

tmux split-window -h -t "$bottom_left"
bottom_right="$(tmux display-message -p '#{pane_id}')"
tmux send-keys -t "$bottom_right" C-c 'reset' C-m

tmux send-keys -t "$top" ' cargo run -p client -- server' C-m
tmux send-keys -t "$bottom_left" ' cargo run -p client' C-m
tmux send-keys -t "$bottom_right" ' cargo run -p client' C-m
