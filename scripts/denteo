#!/bin/zsh

# Check if hist_ignore_space is set
if ! (( $+options[histignorepace] )); then
  setopt hist_ignore_space
  local RESET_HIST_IGNORE_SPACE=1
fi

# Rename the current session to "denteo"
tmux rename-session 'denteo'

# Offer to reopen the worktree windows saved by sw. Asked before any send-keys,
# because keys sent to this pane would be swallowed by read as the answer.
if [ -s "${NT_STATE_FILE:-$HOME/.local/state/nt/windows}" ]; then
  read -k 1 "reply?Restore work (rw)? [Y/n] "
  [ "$reply" != $'\n' ] && echo
  if [[ "$reply" != [nN] ]]; then
    rw
  fi
fi

# Navigate to the specific folder in tmux
cd ~/denteo/dental
tmux send-keys ' cd ~/denteo/dental' C-m

# Split the window vertically: 30% shell on the left, 70% claude on the right
CLAUDE_PANE=$(tmux split-window -h -l 70% -P -F '#{pane_id}')

# Run claude in the new pane
tmux send-keys -t "$CLAUDE_PANE" ' claude' C-m

# If hist_ignore_space was not set before, unset it
if (( $RESET_HIST_IGNORE_SPACE )); then
  unsetopt hist_ignore_space
fi
