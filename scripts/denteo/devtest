#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<EOF
Usage: $(basename "$0") -s <pane>

Opens the checkout or worktree of <pane> (any repo with a bin/dev, e.g. dental
or dhc) for testing. Unless a puma of that checkout already listens, bin/dev
starts in a 5-row pane above the window's claude pane (or its first pane
besides mrview); a second run while it boots waits for that pane instead of
starting another. The port is the one that checkout's puma listens on, since
bin/dev may move off a taken port. Once it answers, the app opens in a new
Firefox tab at http://<DENTEO_SUBDOMAIN>.localhost:<port>, the subdomain coming
from .env.development.local when it sets one. Bound to prefix + t in tmux for
git.panter.ch panes.
EOF
  exit 1
}

SOURCE=""
while getopts ":s:h" opt; do
  case "$opt" in
    s) SOURCE="$OPTARG" ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))
[ -n "$SOURCE" ] && [ $# -eq 0 ] || usage

BOOT_TIMEOUT=180

path="$(tmux display-message -p -t "$SOURCE" '#{pane_current_path}')"
if ! root="$(git -C "$path" rev-parse --show-toplevel 2>/dev/null)"; then
  tmux display-message "devtest: $path is not a git checkout"
  exit 1
fi
if [ ! -x "$root/bin/dev" ]; then
  tmux display-message "devtest: $root has no bin/dev"
  exit 1
fi

env_value() {
  local file="$root/.env.development.local"
  [ -f "$file" ] || return 0
  sed -n "s/^$1=//p" "$file" | tail -n 1 | tr -d "\"'"
}

subdomain="$(env_value DENTEO_SUBDOMAIN)"

# Prints the port a puma started from $root listens on, if any.
server_port() {
  ss -ltnpH | awk '{ addr = $4; sub(/.*:/, "", addr)
    while (match($0, /pid=[0-9]+/)) {
      print addr, substr($0, RSTART + 4, RLENGTH - 4); $0 = substr($0, RSTART + RLENGTH)
    } }' |
    while read -r port pid; do
      [ "$(readlink "/proc/$pid/cwd" 2>/dev/null)" = "$root" ] || continue
      tr '\0' ' ' <"/proc/$pid/cmdline" 2>/dev/null | grep -q '^puma' || continue
      echo "$port"
      break
    done
}

port="$(server_port)"
if [ -z "$port" ]; then
  window="$(tmux display-message -p -t "$SOURCE" '#{window_id}')"
  dev_pane="$(tmux list-panes -t "$window" -F '#{pane_id} #{@dev_root}' |
    awk -v r="$root" 'substr($0, index($0, " ") + 1) == r { print $1; exit }')"
  if [ -z "$dev_pane" ]; then
    target="$(tmux list-panes -t "$window" -F '#{pane_id} #{pane_current_command}' |
      awk '$2 == "claude" { print $1; found = 1; exit }
           $2 != "mrview" && !other { other = $1 }
           END { if (!found && other) print other }')"
    dev_pane="$(tmux split-window -d -v -b -l 5 -t "${target:-$SOURCE}" -c "$root" \
      -P -F '#{pane_id}' "zsh -ic 'bin/dev; exec zsh'")"
    tmux set-option -p -t "$dev_pane" @dev_root "$root"
  fi
  tmux display-message "devtest: waiting for the server of $root"
  for _ in $(seq "$BOOT_TIMEOUT"); do
    port="$(server_port)"
    [ -n "$port" ] && break
    sleep 1
  done
  if [ -z "$port" ]; then
    tmux display-message "devtest: no server of $root listens after ${BOOT_TIMEOUT}s"
    exit 1
  fi
fi

url="http://${subdomain:+$subdomain.}localhost:$port"

firefox --new-tab "$url" >/dev/null 2>&1 &
