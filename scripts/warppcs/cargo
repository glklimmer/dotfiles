#!/usr/bin/env bash
#
# cargo shim that runs `cargo test` for warppcs checkouts on the PC while the
# laptop is docked (see ~/scripts/dock/dock), so test builds leave the
# laptop's CPU to the playtest and `cargo check`.
#
# The checkout, uncommitted and untracked files included, is mirrored with
# rsync to ~/Development/warppcs-tests/<worktree> on the PC, minus .git,
# everything .gitignore and .git/info/exclude exclude, and any Cargo target dir
# (a directory holding CACHEDIR.TAG) within two levels of the root, such as a
# second target dir an agent built into; the tests run there under kache. Output
# streams back with the PC's paths rewritten to the laptop's, and the exit
# status is the remote cargo's. Mirrors of worktrees that no longer exist
# locally are removed on each run. While the PC has less than MIN_FREE_GIB
# free, the target dirs of the least recently tested mirrors are deleted,
# skipping any whose tests are running; they rebuild from kache when next used.
#
# Every other cargo command, any repo but warppcs, an undocked laptop and
# WARPPCS_LOCAL_TESTS=1 run the real cargo locally. A dock connection that
# drops before the tests start also falls back to a local run.

set -euo pipefail

MAIN="$HOME/development/warppcs"
DOCK_SOCK="${XDG_RUNTIME_DIR:-/run/user/$UID}/dock/ssh.sock"
REMOTE_ROOT="Development/warppcs-tests"
MIN_FREE_GIB=40

# Prints the first cargo on PATH that is not this script.
real_cargo() {
  local self dir
  self="$(realpath "$0")"
  IFS=: read -ra dirs <<<"$PATH"
  for dir in "${dirs[@]}"; do
    if [ -x "$dir/cargo" ] && [ "$(realpath "$dir/cargo")" != "$self" ]; then
      echo "$dir/cargo"
      return
    fi
  done
  echo "cargo shim: no real cargo on PATH" >&2
  exit 127
}

CARGO="$(real_cargo)"

run_local() { exec "$CARGO" "$@"; }

# True when the arguments are `cargo [+toolchain] test|t ...`.
is_test() {
  local first="${1:-}"
  [[ "$first" == +* ]] && first="${2:-}"
  [ "$first" = test ] || [ "$first" = t ]
}

DOCK_HOST="${DOCK_HOST:-$(sed -n 's/^export DOCK_HOST=//p' "$HOME/.zshrc.local" 2>/dev/null)}"

docked() {
  [ -n "$DOCK_HOST" ] && [ -S "$DOCK_SOCK" ] &&
    ssh -S "$DOCK_SOCK" -O check "$DOCK_HOST" 2>/dev/null
}

[ -z "${WARPPCS_LOCAL_TESTS:-}" ] || run_local "$@"
is_test "$@" || run_local "$@"
common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
[ "$common" = "$MAIN/.git" ] || run_local "$@"
docked || run_local "$@"

root="$(git rev-parse --show-toplevel)"
name="$(basename "$root")"
[ "$root" = "$MAIN" ] && name=main
remote_dir="$REMOTE_ROOT/$name"
pc() { ssh -S "$DOCK_SOCK" "$DOCK_HOST" "$@"; }

keep="main"
while read -r key path; do
  [ "$key" = worktree ] && [ "$path" != "$MAIN" ] && keep="$keep $(basename "$path")"
done < <(git -C "$MAIN" worktree list --porcelain)

# Runs on the PC with the mirror root, this mirror's name, the free-space floor
# in GiB and the names of every live worktree: drops dead mirrors, stamps this
# one as just used and frees space from the least recently used targets.
prepare_pc() {
  pc "bash -s -- $(printf '%q ' "$REMOTE_ROOT" "$name" "$MIN_FREE_GIB" "$keep")" <<'EOF'
set -e
cd ~/"$1"
mkdir -p "$2"
for d in */; do
  d="${d%/}"
  case " $4 " in *" $d "*) ;; *) rm -rf "$d" ;; esac
done
for d in */; do
  [ -e "$d.last-run" ] || touch -d @0 "$d.last-run"
done
touch "$2/.last-run"
floor=$(($3 * 1024 * 1024))
for stamp in $(ls -1tr */.last-run 2>/dev/null); do
  [ "$(df --output=avail -k . | tail -1)" -ge "$floor" ] && break
  d="${stamp%/.last-run}"
  { [ "$d" = "$2" ] || [ ! -d "$d/target" ]; } && continue
  flock -n "$d/.cargo-shim.lock" rm -rf "$d/target" || true
done
EOF
}

excludes=(--exclude=/.git --exclude=/target --filter=':- .gitignore')
info_exclude="$(git rev-parse --path-format=absolute --git-path info/exclude)"
[ -f "$info_exclude" ] && excludes+=(--exclude-from="$info_exclude")
while read -r tag; do
  excludes+=(--exclude="/${tag%/CACHEDIR.TAG}/")
done < <(find "$root" -mindepth 2 -maxdepth 3 -name .git -prune -o -name CACHEDIR.TAG -printf '%P\n')

if ! prepare_pc ||
  ! rsync -a --delete -e "ssh -S '$DOCK_SOCK'" "${excludes[@]}" \
    "$root/" "$DOCK_HOST:$remote_dir/"; then
  echo "cargo shim: could not reach the PC, testing locally" >&2
  run_local "$@"
fi

echo "cargo shim: running tests on the PC ($DOCK_HOST); WARPPCS_LOCAL_TESTS=1 runs them here" >&2
args="$(printf '%q ' "$@")"
color=never
tty=-T
if [ -t 1 ]; then
  color=always
  tty=-t
fi
remote_abs="$(pc 'echo $HOME')/$remote_dir"
set +e
ssh -S "$DOCK_SOCK" "$tty" "$DOCK_HOST" "cd '$remote_dir' && exec flock .cargo-shim.lock env RUSTC_WRAPPER=\$HOME/.cargo/bin/kache CARGO_TERM_COLOR=$color \$HOME/.cargo/bin/cargo $args" |
  sed -u "s#$remote_abs#$root#g"
status=("${PIPESTATUS[@]}")
set -e
exit "${status[0]}"
