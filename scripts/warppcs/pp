#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<EOF
Usage: $(basename "$0") [-t <pane>] [-b | -w] [players]

Replaces every other pane in the window of <pane> (default: the current pane)
with a warppcs test run of <players> players (2-9, default 2): the host on the
top half of <pane>, since it plays too, and the remaining players as clients
side by side on the bottom half. Only the host builds; the clients wait for that
build and then start one second apart after the host, left to right. With -b the
remaining players are bot kings that ppbots seats in the host's lobby once it
answers, and the host keeps the whole window. With -w every one of the
<players> (1-9) is a bot, the host watches, and the match starts on its own.
All panes
run in <pane>'s directory, so run it from the warppcs checkout or worktree to
test. A failing run rings the bell, so
a broken build gets flagged even when the window is in the background.
EOF
  exit 1
}

if [ -z "${TMUX:-}" ]; then
  echo "Error: must be run inside a tmux session." >&2
  exit 1
fi

server="${TMUX_PANE:-}"
bots=false
seat_flags=""
while getopts ":t:bwh" opt; do
  case "$opt" in
    t) server="$OPTARG" ;;
    b) bots=true ;;
    w) bots=true seat_flags="-w " ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))

PLAYERS="${1:-2}"
if [ -n "$seat_flags" ]; then
  [[ "$PLAYERS" =~ ^[1-9]$ ]] && [ $# -le 1 ] || usage
else
  [[ "$PLAYERS" =~ ^[2-9]$ ]] && [ $# -le 1 ] || usage
fi
CLIENTS=$((PLAYERS - 1))

server="$(tmux display-message -p -t "$server" '#{pane_id}')"
dir="$(tmux display-message -p -t "$server" '#{pane_current_path}')"
tmux kill-pane -a -t "$server"
tmux send-keys -t "$server" C-c 'reset' C-m

if $bots; then
  seat="$(dirname "$(readlink -f "$0")")/ppbots $seat_flags$PLAYERS"
  tmux send-keys -t "$server" " cargo build -p client -p ppc_console && { $seat >/dev/null 2>&1 & cargo run -p client -- server; } || printf '\a'" C-m
  exit 0
fi

clients=("$(tmux split-window -v -d -P -F '#{pane_id}' -c "$dir" -t "$server")")
for _ in $(seq 2 "$CLIENTS"); do
  clients+=("$(tmux split-window -h -d -P -F '#{pane_id}' -c "$dir" -t "${clients[-1]}")")
done

width=$(($(tmux display-message -p -t "$server" '#{window_width}') / CLIENTS))
for pane in "${clients[@]::${#clients[@]}-1}"; do
  tmux resize-pane -t "$pane" -x "$width"
done

ready="pp-ready-${server#%}"
tmux send-keys -t "$server" " cargo build -p client; tmux wait-for -S $ready; cargo run -p client -- server || printf '\a'" C-m
delay=1
for pane in "${clients[@]}"; do
  tmux send-keys -t "$pane" " tmux wait-for $ready; sleep $delay; cargo run -p client || printf '\a'" C-m
  delay=$((delay + 1))
done
