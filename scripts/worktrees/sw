#!/usr/bin/env bash
set -euo pipefail

STATE_FILE="${NT_STATE_FILE:-$HOME/.local/state/nt/windows}"
SESSION=""
MODE=save

usage() {
  cat >&2 <<EOF
Usage: $(basename "$0") [-s <session>] [-l | -o]

Save work: records every tmux window that sits in a dental, dhc or warppcs
worktree as "<repo> <branch> [<window-name>]" in $STATE_FILE, so rw can reopen
them later. The name is kept only for windows tmux does not auto-rename, i.e.
ones named by nt or by hand.

Saving replaces the entries of each project (denteo = dental and dhc, warppcs)
that has any window open in one of its checkouts, and keeps the saved entries
of projects with no window open, so a warppcs day does not drop the denteo
windows saved the day before.

  -s <session>  Only read this session (default: all sessions; works outside tmux).
  -l            Print what would be saved without saving it.
  -o            Print only the entries of windows open right now.
EOF
  exit 1
}

while getopts ":s:loh" opt; do
  case "$opt" in
    s) SESSION="$OPTARG" ;;
    l) MODE=list ;;
    o) MODE=open ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))
[ $# -eq 0 ] || usage

project_of() {
  case "$1" in
    dental | dhc) echo denteo ;;
    *) echo "$1" ;;
  esac
}

# Prints "<project>" for any path inside a checkout of a known repo, followed
# by "<repo> <branch> [<name>]" when it is a linked worktree. The main
# checkouts get no entry because rw never opens windows there.
scan_path() {
  local path="$1" name="$2" common top branch repo
  common=$(git -C "$path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 0
  top=$(git -C "$path" rev-parse --show-toplevel 2>/dev/null) || return 0
  case "$common" in
    "$HOME/denteo/dental/.git") repo=dental ;;
    "$HOME/denteo/dhc/.git") repo=dhc ;;
    "$HOME/development/warppcs/.git") repo=warppcs ;;
    *) return 0 ;;
  esac
  project_of "$repo"
  [ "$top" = "${common%/.git}" ] && return 0
  branch=$(git -C "$path" branch --show-current)
  [ -n "$branch" ] && echo "$repo $branch${name:+ $name}"
}

scan() {
  local target=(-a)
  [ -n "$SESSION" ] && target=(-t "$SESSION")
  tmux list-windows "${target[@]}" \
    -F '#{?@pp_root,,#{pane_current_path}}'$'\t''#{?automatic-rename,,#{window_name}}' 2>/dev/null |
    while IFS=$'\t' read -r path name; do
      [ -n "$path" ] || continue
      scan_path "$path" "$name"
    done
}

SCAN=$(scan)
OPEN=$(grep ' ' <<<"$SCAN" | awk '!seen[$1 " " $2]++' || true)

if [ "$MODE" = open ]; then
  [ -z "$OPEN" ] || echo "$OPEN"
  exit 0
fi

LIVE=$(grep -v ' ' <<<"$SCAN" | sort -u || true)

kept_entries() {
  [ -s "$STATE_FILE" ] || return 0
  while read -r repo rest; do
    [ -n "$repo" ] || continue
    grep -qxF "$(project_of "$repo")" <<<"$LIVE" || echo "$repo $rest"
  done <"$STATE_FILE"
}

ENTRIES=$({
  kept_entries
  [ -z "$OPEN" ] || echo "$OPEN"
})

if [ "$MODE" = list ]; then
  [ -z "$ENTRIES" ] || echo "$ENTRIES"
  exit 0
fi

mkdir -p "$(dirname "$STATE_FILE")"
if [ -n "$ENTRIES" ]; then echo "$ENTRIES"; fi >"$STATE_FILE"
echo "Saved $(wc -l <"$STATE_FILE") window(s) to $STATE_FILE"
cat "$STATE_FILE"
