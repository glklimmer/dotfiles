#!/usr/bin/env bash
set -euo pipefail

REPO=""
WINDOW_NAME=""

usage() {
  cat >&2 <<EOF
Usage: $(basename "$0") [-r dental|dhc|warppcs] [-n <window-name>] <branch-name> [prompt...]

Examples:
    $(basename "$0") feat/1234-add-feature
    $(basename "$0") -r dhc feat/1234-add-feature
    $(basename "$0") -r warppcs feat/raid-lock
    $(basename "$0") feat/1234-add-feature "Read HANDOFF.md and implement it"

Creates (or reuses) a worktree for <branch> in the selected repo, opens a new
tmux window in it, runs bin/setup-worktree, then starts claude once setup
completes. Without -r the repo is the one the current directory is checked out
from (~/denteo/dental, ~/denteo/dhc, ~/development/warppcs or any of their
worktrees), falling back to dental anywhere else. dhc lives in ~/denteo/dhc.
warppcs lives in ~/development/warppcs, where the worktree is added under
.claude/worktrees with plain git (branched off origin/master when new) and
needs no setup step. -n overrides the window name derived from the branch;
only dhc windows get a "dhc/" prefix, since dental shares their tmux session
and warppcs has one of its own.

If a prompt is given, the new claude session is seeded with it (claude
--continue when reusing an existing worktree). For long handoffs, put the
spec in a file and pass a short prompt that points claude at it.
EOF
  exit 1
}

while getopts ":r:n:h" opt; do
  case "$opt" in
    r) REPO="$OPTARG" ;;
    n) WINDOW_NAME="$OPTARG" ;;
    h) usage ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))

[ $# -ge 1 ] || usage

# Prints the repo whose checkout (main or linked worktree) contains the current
# directory, or dental outside of all of them.
detect_repo() {
  local common
  common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || common=""
  case "$common" in
    "$HOME/denteo/dhc/.git") echo dhc ;;
    "$HOME/development/warppcs/.git") echo warppcs ;;
    *) echo dental ;;
  esac
}

[ -n "$REPO" ] || REPO=$(detect_repo)

if [ -z "${TMUX:-}" ]; then
  echo "Error: must be run inside a tmux session." >&2
  exit 1
fi

BRANCH="$1"
shift
PROMPT="$*"

# Per-repo worktree tooling. The denteo CLIs take the same `code:<cmd> <branch>`
# arguments, so only the path and the entrypoint differ. warppcs has no such
# tooling, so CREATE_CMD is empty and create_warppcs_worktree runs instead.
SETUP_CMD="bin/setup-worktree && "
case "$REPO" in
  dental)
    REPO_DIR="$HOME/denteo/dental"
    CREATE_CMD="script/pan.do"
    ;;
  dhc)
    REPO_DIR="$HOME/denteo/dhc"
    CREATE_CMD="bin/ws"
    ;;
  warppcs)
    REPO_DIR="$HOME/development/warppcs"
    CREATE_CMD=""
    SETUP_CMD=""
    ;;
  *)
    echo "Error: unknown repo '$REPO' (expected dental, dhc or warppcs)" >&2
    exit 1
    ;;
esac

if [ ! -d "$REPO_DIR" ]; then
  echo "Error: $REPO_DIR not found" >&2
  exit 1
fi

find_worktree() {
  git -C "$REPO_DIR" worktree list --porcelain | awk -v b="$BRANCH" '
    /^worktree / { wt = substr($0, 10); next }
    /^branch refs\/heads\// {
      if (!found && substr($0, 19) == b) { found = wt }
    }
    END { if (found) print found }
  '
}

# Adds a warppcs worktree for $BRANCH in .claude/worktrees, next to the ones
# claude creates, so sw and rw pick it up the same way. $1 is the subcommand
# the denteo CLIs would get: code:checkout for an existing branch (git tracks
# origin's copy when there is no local one), code:new to branch off a freshly
# fetched origin/master.
create_warppcs_worktree() {
  local dir="$REPO_DIR/.claude/worktrees/${BRANCH//\//-}"
  if [ "$1" = code:checkout ]; then
    git -C "$REPO_DIR" fetch origin
    git -C "$REPO_DIR" worktree add "$dir" "$BRANCH"
  else
    git -C "$REPO_DIR" fetch origin master
    git -C "$REPO_DIR" worktree add --no-track -b "$BRANCH" "$dir" origin/master
  fi
}

WORKTREE_DIR=$(find_worktree)

if [ -n "$WORKTREE_DIR" ] && [ -d "$WORKTREE_DIR" ]; then
  echo "Reusing existing $REPO worktree at $WORKTREE_DIR"
  CLAUDE_CMD="claude --continue"
else
  CLAUDE_CMD="claude"
  # Pick code:checkout if branch exists locally or on origin, otherwise code:new
  if git -C "$REPO_DIR" show-ref --verify --quiet "refs/heads/$BRANCH" ||
    git -C "$REPO_DIR" ls-remote --exit-code --heads origin "$BRANCH" >/dev/null 2>&1; then
    SUBCMD="code:checkout"
  else
    SUBCMD="code:new"
  fi

  if [ -n "$CREATE_CMD" ]; then
    echo "Creating $REPO worktree for $BRANCH ($CREATE_CMD $SUBCMD)"
    (cd "$REPO_DIR" && "$CREATE_CMD" "$SUBCMD" "$BRANCH")
  else
    echo "Creating $REPO worktree for $BRANCH (git worktree add, $SUBCMD)"
    create_warppcs_worktree "$SUBCMD"
  fi

  WORKTREE_DIR=$(find_worktree)

  if [ -z "$WORKTREE_DIR" ] || [ ! -d "$WORKTREE_DIR" ]; then
    echo "Error: could not locate $REPO worktree for branch $BRANCH" >&2
    exit 1
  fi
fi

# Auto-accept mode: when NT_AUTO is set, run claude with its permission prompts
# off so a handoff agent works unattended. Opt-in so interactive reuse stays safe.
if [ -n "${NT_AUTO:-}" ]; then
  CLAUDE_CMD="$CLAUDE_CMD --permission-mode auto"
fi

# Seed the new claude session with the prompt, if one was given. The prompt is
# written to a temp file and read (then removed) in the NEW window's shell, so
# arbitrary content — quotes, backticks, $ — survives without any escaping.
if [ -n "$PROMPT" ]; then
  PROMPT_FILE=$(mktemp)
  printf '%s' "$PROMPT" >"$PROMPT_FILE"
  CLAUDE_CMD="$CLAUDE_CMD \"\$(cat '$PROMPT_FILE'; rm -f '$PROMPT_FILE')\""
fi

# Single pane: run setup-worktree to completion, then launch claude.
# '&&' guarantees claude only starts once setup has fully succeeded, so the
# worktree env, deps, and db are ready — no racing on partial setup.
NEW_WIN_ID=$(tmux new-window -d -P -F '#{window_id}' -c "$WORKTREE_DIR" \
  "$SETUP_CMD$CLAUDE_CMD; exec \$SHELL")

# Title: leading ticket number if present, otherwise first dashed word
TITLE="${BRANCH##*/}"
TITLE="${TITLE#worktree-}"
NUM="${TITLE%%[!0-9]*}"
if [ -n "$NUM" ]; then
  TITLE="$NUM"
else
  TITLE="${TITLE%%-*}"
fi
if [ "$REPO" = "dhc" ]; then
  TITLE="$REPO/$TITLE"
fi
[ -n "$WINDOW_NAME" ] && TITLE="$WINDOW_NAME"
tmux rename-window -t "$NEW_WIN_ID" "$TITLE"
tmux set-window-option -t "$NEW_WIN_ID" automatic-rename off
