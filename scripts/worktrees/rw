#!/usr/bin/env bash
set -euo pipefail

STATE_FILE="${NT_STATE_FILE:-$HOME/.local/state/nt/windows}"
PROJECT=""

usage() {
  cat >&2 <<EOF
Usage: $(basename "$0") [-p denteo|warppcs]

Restore work: reopens each worktree window saved by sw in the current tmux
session through \`nt -r <repo> [-n <name>] <branch>\`, skipping branches that
already have a window open anywhere. nt recreates a worktree that is gone, and
in one that still exists the window runs \`claude --continue\` and resumes its
last session.

  -p <project>  Only restore that project's entries (denteo = dental and dhc).
EOF
  exit 1
}

while getopts ":p:h" opt; do
  case "$opt" in
    p) PROJECT="$OPTARG" ;;
    *) usage ;;
  esac
done
shift $((OPTIND - 1))
[ $# -eq 0 ] || usage

case "$PROJECT" in
  "" | denteo | warppcs) ;;
  *) usage ;;
esac

if [ -z "${TMUX:-}" ]; then
  echo "Error: must be run inside a tmux session." >&2
  exit 1
fi

if [ ! -s "$STATE_FILE" ]; then
  echo "Nothing saved in $STATE_FILE (run sw first)" >&2
  exit 1
fi

project_of() {
  case "$1" in
    dental | dhc) echo denteo ;;
    *) echo "$1" ;;
  esac
}

OPEN=$(sw -o | cut -d" " -f1,2)

while read -r repo branch name; do
  [ -n "$branch" ] || continue
  [ -z "$PROJECT" ] || [ "$(project_of "$repo")" = "$PROJECT" ] || continue
  if grep -qxF "$repo $branch" <<<"$OPEN"; then
    echo "Already open: $repo $branch"
    continue
  fi
  name_opt=()
  [ -n "$name" ] && name_opt=(-n "$name")
  nt -r "$repo" "${name_opt[@]}" "$branch" </dev/null || echo "Failed to restore: $repo $branch" >&2
done <"$STATE_FILE"
