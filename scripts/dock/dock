#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<EOF
Usage: $(basename "$0") on|off|status

Docks this laptop to the PC over the network, as if its peripherals were
plugged in here:
  - two fake outputs on the laptop, streamed with wayvnc to fullscreen VNC
    viewers on the PC's two monitors
  - the PC's speakers, headphones and microphone as laptop audio devices
  - the PC's mouse, keyboard and webcam attached over USB/IP

Everything runs over SSH; nothing new listens on the LAN. One connection
carries audio, USB/IP and control, a second one only the VNC streams. If
either ends without "dock off", both sides undock by themselves.
It prefers a direct Ethernet cable between laptop and PC (fixed addresses in
10.42.0.0/24 next to DHCP, the "dock" NetworkManager connection on both) and
falls back to Wi-Fi.

Needs DOCK_HOST (e.g. user@192.168.1.22) in ~/.zshrc.local, plus the one-time
setup in ~/scripts/bootstrap: root helpers dock-root (laptop) and dock-usb (PC)
and the cable connections.
EOF
  exit 1
}

DOCK_USB=(1532:0067 046d:c349 046d:0893)

OUTPUTS=(HDMI-A-1 Virtual-1)
VNC_PORTS=(5900 5901)
LAYOUT=("HDMI-A-1 0 0" "Virtual-1 1920 0" "eDP-1 1920 1080")

CABLE_PC=10.42.0.2
WATCHDOG_TIMEOUT=30

PULSE_PORT=24713
USBIP_PORT=13240

PC_CARD=alsa_card.pci-0000_00_1f.3
PC_SPEAKERS=alsa_output.pci-0000_00_1f.3.pro-output-1
PC_HEADPHONES=alsa_output.pci-0000_00_1f.3.pro-output-0
PC_MIC=alsa_input.usb-Kingston_HyperX_Quadcast_4110-00.analog-stereo

LAPTOP_CARD=alsa_card.pci-0000_00_1f.3-platform-skl_hda_dsp_generic

STATE="${XDG_RUNTIME_DIR:-/run/user/$UID}/dock"
SOCK="$STATE/ssh.sock"
VNC_SOCK="$STATE/vnc.sock"
PC_SINK_FILE="${XDG_STATE_HOME:-$HOME/.local/state}/dock/sink"

step() { printf '\033[1;34m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m%s\033[0m\n' "$*" >&2; }
die() { echo "dock: $*" >&2; exit 1; }

connected() { [ -S "$SOCK" ] && ssh -S "$SOCK" -O check "$DOCK_HOST" 2>/dev/null; }

route() { cat "$STATE/route" 2>/dev/null; }

##
# Runs a bash script from stdin on the PC through the shared connection.
# The PC's login shell is zsh, which does not word-split, so remote logic
# always goes through bash.
pc() { ssh -S "$SOCK" "$DOCK_HOST" bash -s -- "$@"; }

##
# Hands everything back to the PC: closes the viewers and the idle inhibitor,
# unloads the pulse server the laptop used and unbinds the USB devices. Runs on
# the PC from both `dock off` and the watchdog, and does nothing when nothing is
# docked.
read -r -d '' PC_RELEASE <<'EOF' || true
state="/run/user/$(id -u)/dock"
[ -s "$state/watchdog.pid" ] && kill -- -"$(cat "$state/watchdog.pid")" 2>/dev/null
[ -f "$state/viewers.pids" ] && while read -r pid; do kill -- -"$pid"; done <"$state/viewers.pids" 2>/dev/null
[ -s "$state/pulse-module" ] && pactl unload-module "$(cat "$state/pulse-module")"
rm -rf "$state"
exec sudo -n dock-usb stop
EOF

cable_up() { ip -4 route get "$CABLE_PC" 2>/dev/null | grep -q " dev en"; }

##
# Opens two master connections over the cable when possible, else Wi-Fi, where
# power saving has to be off or every round trip can take ~200 ms. The main one
# carries pulse and usbipd from the PC plus every remote command; the second one
# only the VNC ports to the PC. Inside one TCP stream a burst of video frames
# (30-40 MB/s while a video plays) queues ahead of the audio and starves the
# PC's playback buffer, so audio crackles; as separate streams, fq_codel on the
# way out interleaves them. HostKeyAlias checks the cable address against the
# key known for DOCK_HOST.
connect() {
  local ssh=(ssh -fNM -o ExitOnForwardFailure=yes -o ServerAliveInterval=5 -o ConnectTimeout=5
    -o HostKeyAlias="${DOCK_HOST#*@}")
  local main=(-S "$SOCK" -L "127.0.0.1:$PULSE_PORT:127.0.0.1:4713" -L "127.0.0.1:$USBIP_PORT:127.0.0.1:3240")
  local vnc=(-S "$VNC_SOCK") port host=$DOCK_HOST
  for port in "${VNC_PORTS[@]}"; do vnc+=(-R "$port:127.0.0.1:$port"); done
  if cable_up; then
    step "connecting over the cable"
    host="${DOCK_HOST%@*}@$CABLE_PC"
    if "${ssh[@]}" "${main[@]}" "$host"; then
      echo cable >"$STATE/route"
      "${ssh[@]}" "${vnc[@]}" "$host"
      return
    fi
    warn "no answer over the cable, trying Wi-Fi"
    host=$DOCK_HOST
  fi
  step "connecting over Wi-Fi"
  sudo -n dock-root wifi-powersave off
  echo wifi >"$STATE/route"
  "${ssh[@]}" "${main[@]}" "$host"
  "${ssh[@]}" "${vnc[@]}" "$host"
}

disconnect() {
  ssh -S "$VNC_SOCK" -O exit "$DOCK_HOST" 2>/dev/null || true
  ssh -S "$SOCK" -O exit "$DOCK_HOST" 2>/dev/null || true
  [ "$(route)" != wifi ] || sudo -n dock-root wifi-powersave on || true
}

##
# Runs `dock off` by itself once either connection to the PC ends without it, so
# windows do not stay on fake outputs nobody can see after the PC goes away,
# the cable is pulled or the laptop wakes up elsewhere. ServerAliveInterval
# ends the connection about 15 s after the PC stops answering.
watch_connection() {
  local masters=() sock
  for sock in "$SOCK" "$VNC_SOCK"; do
    masters+=("$(ssh -S "$sock" -O check "$DOCK_HOST" 2>&1 | grep -oP 'pid=\K[0-9]+')")
  done
  setsid "$(readlink -f "$0")" await-disconnect "${masters[@]}" >/dev/null 2>&1 </dev/null &
  echo $! >"$STATE/watcher.pid"
}

##
# Starts a watchdog on the PC that runs PC_RELEASE once the laptop is gone, so
# closing the lid or pulling the cable without `dock off` does not leave the PC
# with frozen viewers covering its monitors and no mouse. The laptop counts as
# gone when it has not answered a ping for WATCHDOG_TIMEOUT seconds (suspended,
# off, out of range) or when this SSH connection has ended. The ping matters
# because sshd alone would not notice a vanished peer for many minutes. Any
# state left by an earlier dock that never got that far is released first.
watchdog_on() {
  { printf 'release=%q\n' "$PC_RELEASE"; cat <<'EOF'; } | pc "$WATCHDOG_TIMEOUT"
set -e
state="/run/user/$(id -u)/dock"
bash -c "$release" || true
mkdir -p "$state"
printf '%s\n' "$release" >"$state/release"
sshd=$$
until [ "$(ps -o comm= -p "$sshd")" = sshd ]; do
  sshd=$(ps -o ppid= -p "$sshd" | tr -d ' ')
  [ "$sshd" -gt 1 ]
done
setsid bash -c '
  last=$SECONDS
  while kill -0 "$1" 2>/dev/null && [ $((SECONDS - last)) -lt "$3" ]; do
    sleep 5
    ping -c1 -W2 "$2" >/dev/null 2>&1 && last=$SECONDS
  done
  rm -f "$4/watchdog.pid"
  exec bash "$4/release"
' _ "$sshd" "${SSH_CLIENT%% *}" "$1" "$state" >/dev/null 2>&1 </dev/null &
echo $! >"$state/watchdog.pid"
EOF
}

wait_for_outputs() {
  local list output missing
  for _ in $(seq 50); do
    list=$(cosmic-randr list --kdl)
    missing=0
    for output in "${OUTPUTS[@]}"; do
      grep -q "^output \"$output\"" <<<"$list" || missing=1
    done
    [ "$missing" = 0 ] && return
    sleep 0.2
  done
  die "outputs ${OUTPUTS[*]} did not appear"
}

wait_for_port() {
  for _ in $(seq 25); do
    ss -Hltn "sport = :$1" | grep -q . && return
    sleep 0.2
  done
  die "nothing listening on port $1"
}

##
# Fake outputs on the laptop, each streamed by wayvnc to a fullscreen viewer on
# one PC monitor. The PC gets no input from its own mouse meanwhile, so GNOME is
# inhibited from blanking or suspending, which would cut the dock off. Over the
# cable the viewers ask for lossless frames; over Wi-Fi a playing video would
# then fill the link, so they allow JPEG, which TigerVNC applies only to
# many-coloured regions such as video and leaves text lossless.
monitors_on() {
  step "monitors"
  sudo -n dock-root monitors on
  wait_for_outputs
  local output entry name x y i
  for output in "${OUTPUTS[@]}"; do cosmic-randr mode "$output" 1920 1080; done
  for entry in "${LAYOUT[@]}"; do
    read -r name x y <<<"$entry"
    cosmic-randr position "$name" "$x" "$y"
  done
  for i in "${!OUTPUTS[@]}"; do
    setsid wayvnc --disable-input --render-cursor --output "${OUTPUTS[$i]}" \
      --socket "$STATE/wayvnc-$i.sock" 127.0.0.1 "${VNC_PORTS[$i]}" \
      >"$STATE/wayvnc-$i.log" 2>&1 </dev/null &
    echo $! >>"$STATE/wayvnc.pids"
  done
  for i in "${!VNC_PORTS[@]}"; do wait_for_port "${VNC_PORTS[$i]}"; done
  pc "$(route)" "${VNC_PORTS[@]}" <<'EOF'
set -e
quality=(-NoJPEG)
[ "$1" = wifi ] && quality=(-QualityLevel=8)
shift
state="/run/user/$(id -u)/dock"
mkdir -p "$state"
shell=$(pgrep -u "$USER" -x gnome-shell | head -1)
export $(tr '\0' '\n' <"/proc/$shell/environ" | grep -E '^(DISPLAY|XAUTHORITY|WAYLAND_DISPLAY|DBUS_SESSION_BUS_ADDRESS)=')
setsid gnome-session-inhibit --inhibit idle:suspend --reason "laptop docked" sleep infinity >/dev/null 2>&1 </dev/null &
echo $! >>"$state/viewers.pids"
monitor=1
for port in "$@"; do
  setsid vncviewer -FullScreen -FullScreenMode=Selected -FullScreenSelectedMonitors=$monitor \
    -ViewOnly -SecurityTypes=None -AutoSelect=0 "${quality[@]}" -CompressLevel=1 -DotWhenNoCursor=0 \
    "localhost::$port" >/dev/null 2>&1 </dev/null &
  echo $! >>"$state/viewers.pids"
  monitor=$((monitor + 1))
done
EOF
}

##
# Waits until pipewire-pulse lists a node, since tunnel modules and card profile
# changes return before their sink or source exists and set-default-* would
# fail. Returns non-zero after 5 s so `off` can carry on regardless.
wait_for_node() {
  for _ in $(seq 25); do
    pactl list short "$1" | grep -q "	$2	" && return
    sleep 0.2
  done
  return 1
}

##
# Prints the PipeWire object id and the active profile index of a card.
card_state() {
  pw-dump Device | python3 -Ic 'import json, sys
for o in json.load(sys.stdin):
    if o["info"]["props"].get("device.name") == sys.argv[1]:
        print(o["id"], o["info"]["params"]["Profile"][0]["index"])' "$1"
}

##
# Switches a card to a profile index without WirePlumber remembering it, unlike
# `pactl set-card-profile`. A laptop rebooted while docked therefore comes back
# with its card on rather than stuck on "off".
set_card_profile() {
  local id _
  read -r id _ < <(card_state "$1")
  [ -n "$id" ] && pw-cli set-param "$id" Profile "{ index: $2, save: false }" >/dev/null
}

##
# The PC's onboard card can only drive the digital (speakers) or the analog
# (headphones) output at a time in its normal profiles, so it stays on
# pro-audio, which exposes both; bootstrap sets that up for good (see
# dock_pc_audio there). Should the profile have been changed since, it is
# switched back. Pro-audio leaves the hardware mixer as it was and offers no
# control over it, so the digital output is unmuted and the analog Master,
# which attenuates the headphones, is set to 0 dB; volume is then the laptop's
# alone.
#
# The laptop's own card is switched off meanwhile, so only the PC's devices are
# offered while docked; `off` restores its profile, so undocked every output and
# microphone is back.
#
# The PC output selected when the last dock ended (see save_pc_sink) is selected
# again, the speakers the first time.
audio_on() {
  step "audio"
  pc "$PC_CARD" <<'EOF'
set -e
state="/run/user/$(id -u)/dock"
mkdir -p "$state"
pactl list short modules | grep -q 'module-native-protocol-tcp.*listen=127.0.0.1' ||
  pactl load-module module-native-protocol-tcp listen=127.0.0.1 port=4713 auth-anonymous=true >"$state/pulse-module"
pactl set-card-profile "$1" pro-audio
card=$(pactl list cards | awk -v card="$1" '$1 == "Name:" { found = ($2 == card) } found && $1 == "api.alsa.card" { gsub(/"/, "", $3); print $3; exit }')
amixer -q -c "$card" sset IEC958 on
amixer -q -c "$card" sset Master 0dB unmute
EOF
  pactl get-default-sink >"$STATE/default-sink"
  pactl get-default-source >"$STATE/default-source"
  [ -s "$STATE/laptop-profile" ] || card_state "$LAPTOP_CARD" | cut -d' ' -f2 >"$STATE/laptop-profile"
  set_card_profile "$LAPTOP_CARD" 0
  local server="server=tcp:127.0.0.1:$PULSE_PORT" latency=250
  [ "$(route)" = cable ] && latency=60
  local awake='session.suspend-timeout-seconds=0'
  {
    pactl load-module module-tunnel-sink "$server" latency_msec="$latency" sink_name=pc_speakers \
      sink="$PC_SPEAKERS" "sink_properties=\"device.description=\\\"PC - Speakers\\\" $awake\""
    pactl load-module module-tunnel-sink "$server" latency_msec="$latency" sink_name=pc_headphones \
      sink="$PC_HEADPHONES" "sink_properties=\"device.description=\\\"PC - Headphones\\\" $awake\""
    pactl load-module module-tunnel-source "$server" latency_msec=100 source_name=pc_mic \
      source="$PC_MIC" "source_properties=\"device.description=\\\"PC - Microphone\\\"\""
  } >"$STATE/pulse-modules"
  local sink
  sink=$(cat "$PC_SINK_FILE" 2>/dev/null) || true
  [[ "$sink" =~ ^pc_(speakers|headphones)$ ]] || sink=pc_speakers
  wait_for_node sinks "$sink" || die "audio sink $sink did not appear"
  wait_for_node sources pc_mic || die "audio source pc_mic did not appear"
  pactl set-default-sink "$sink"
  pactl set-default-source pc_mic
}

##
# Remembers which PC output is selected so the next dock selects it again. When
# the connection dropped first, the tunnel sinks are already gone and the
# default has fallen back to another sink; the earlier choice is kept then.
save_pc_sink() {
  local sink
  sink=$(pactl get-default-sink 2>/dev/null) || return 0
  [[ "$sink" =~ ^pc_(speakers|headphones)$ ]] || return 0
  mkdir -p "${PC_SINK_FILE%/*}"
  echo "$sink" >"$PC_SINK_FILE"
}

usb_on() {
  step "mouse, keyboard + webcam"
  local busids
  busids=$(ssh -S "$SOCK" "$DOCK_HOST" sudo -n dock-usb start "${DOCK_USB[@]}")
  mapfile -t busids <<<"$busids"
  sudo -n dock-root usb attach "${busids[@]}"
}

on() {
  connected && die "already docked"
  trap 'warn "docking failed; run: dock off"' ERR
  mkdir -p "$STATE"
  connect
  watch_connection
  watchdog_on
  monitors_on
  audio_on
  usb_on
  step "docked"
}

##
# Undoes every step even when some fail, so a half-finished on or a dropped
# connection still leaves both machines usable. Without a connection the PC's
# watchdog has already taken its devices back, or will once the laptop is gone.
off() {
  if [ -s "$STATE/watcher.pid" ] && [ "$(cat "$STATE/watcher.pid")" != $$ ]; then
    kill "$(cat "$STATE/watcher.pid")" 2>/dev/null || true
  fi
  step "mouse, keyboard + webcam"
  sudo -n dock-root usb detach || true
  step "audio"
  save_pc_sink
  if [ -f "$STATE/pulse-modules" ]; then xargs -r -n1 pactl unload-module <"$STATE/pulse-modules" 2>/dev/null || true; fi
  if [ -s "$STATE/laptop-profile" ]; then
    set_card_profile "$LAPTOP_CARD" "$(cat "$STATE/laptop-profile")" || true
  fi
  if [ -s "$STATE/default-sink" ]; then
    wait_for_node sinks "$(cat "$STATE/default-sink")" || true
    pactl set-default-sink "$(cat "$STATE/default-sink")" || true
  fi
  if [ -s "$STATE/default-source" ]; then
    wait_for_node sources "$(cat "$STATE/default-source")" || true
    pactl set-default-source "$(cat "$STATE/default-source")" || true
  fi
  step "PC"
  if connected; then
    pc <<<"$PC_RELEASE" || warn "could not hand everything back to the PC"
  else
    warn "no connection to the PC; it takes everything back by itself ${WATCHDOG_TIMEOUT}s after losing the laptop"
  fi
  step "monitors"
  if [ -f "$STATE/wayvnc.pids" ]; then xargs -r kill <"$STATE/wayvnc.pids" 2>/dev/null || true; fi
  sudo -n dock-root monitors off || true
  disconnect
  rm -rf "$STATE"
  step "undocked"
}

status() {
  if connected; then echo "docked to $DOCK_HOST over $(route)"; else echo "not docked"; fi
  cosmic-randr list --kdl | grep -E '^output' | cut -d'"' -f2 | paste -sd' ' | sed 's/^/outputs: /'
  pactl list short sinks | awk '$2 ~ /^pc_/ { print "audio:   " $2 }'
  pactl list short sources | awk '$2 ~ /^pc_/ { print "audio:   " $2 }'
  lsusb | grep -iE "$(printf '%s|' "${DOCK_USB[@]}" | sed 's/|$//')" | sed 's/^/usb:     /' || true
}

[ -n "${DOCK_HOST:-}" ] || die "set DOCK_HOST (e.g. user@192.168.1.22) in ~/.zshrc.local"

case "${1:-}" in
  on) on ;;
  off) off ;;
  await-disconnect)
    while kill -0 "$2" 2>/dev/null && kill -0 "$3" 2>/dev/null; do sleep 2; done
    off
    ;;
  status) status ;;
  *) usage ;;
esac
