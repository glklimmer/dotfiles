#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<EOF
Usage: $(basename "$0") [--add PROFILE] [--remove PROFILE]

Installs every tool and program this machine needs (Pop!_OS / Ubuntu) and
wires up the dotfiles. Safe to re-run: each step skips what is already there.

Profiles add the setup of one project on top (${PROFILES[*]}), each defined
in ~/scripts/<profile>/bootstrap.sh. The first run asks which ones this
machine gets and remembers the answer; --add and --remove change it later.

Fresh machine:
    bash <(curl -fsSL https://raw.githubusercontent.com/glklimmer/dotfiles/master/scripts/bootstrap)
EOF
  exit 1
}

APT_PACKAGES=(
  zsh tmux curl unzip p7zip-full build-essential
  ripgrep fd-find fzf jq xclip wl-clipboard htop
  ffmpegthumbnailer imagemagick poppler-utils
  gh
  # alacritty build deps
  cmake g++ pkg-config libfontconfig1-dev libxcb-xfixes0-dev libxkbcommon-dev python3
)

DOCK_APT_PACKAGES=(
  iw xxd
  # wayvnc build deps
  meson ninja-build libpixman-1-dev libdrm-dev libgbm-dev libwayland-dev wayland-protocols
  libjansson-dev libturbojpeg0-dev libgnutls28-dev nettle-dev libgmp-dev zlib1g-dev libpam0g-dev
)

DOCK_PC_PACKAGES=(tigervnc-viewer iw linux-tools-generic)

WAYVNC_VERSION=v0.10.2
NEATVNC_VERSION=v1.0.3
AML_VERSION=v1.0.0

FLATPAKS=(com.google.Chrome com.spotify.Client)

ZSH_PLUGINS=(
  https://github.com/zsh-users/zsh-autosuggestions
  https://github.com/zsh-users/zsh-syntax-highlighting
  https://github.com/jeffreytse/zsh-vi-mode
)

PANEL_APPLETS_LEFT=(com.system76.CosmicAppletWorkspaces)
PANEL_APPLETS_RIGHT=(
  com.system76.CosmicAppletTime
  com.system76.CosmicAppletStatusArea
  com.system76.CosmicAppletBluetooth
  com.system76.CosmicAppletAudio
  com.system76.CosmicAppletNetwork
  com.system76.CosmicAppletBattery
)

TRIDACTYL_NATIVE_VERSION=1.25.1

CLAUDE_PLUGINS=(tmux-claude-status@tmux-claude-status)

PROFILES=(denteo warppcs)
PROFILES_FILE="$HOME/.config/bootstrap/profiles"

##
# Reminders printed after the final step; profiles append to it.
NEXT_STEPS=("log out and back in (zsh)")

step() { printf '\n\033[1;34m==> %s\033[0m\n' "$*"; }
has() { command -v "$1" &>/dev/null; }

ask() {
  local reply
  read -rp "$1: " reply
  printf '%s' "$reply"
}

ask_secret() {
  local reply
  read -rsp "$1: " reply
  echo >&2
  printf '%s' "$reply"
}

##
# Creates a machine-local file readable only by the user, unless it exists.
ensure_private() {
  [ -f "$1" ] || install -D -m 600 /dev/null "$1"
}

clone() {
  local url="$1" dir="$2"
  [ -d "$dir" ] || git clone --depth 1 "$url" "$dir"
}

setup_git_identity() {
  step "git identity"
  git config --global user.name >/dev/null ||
    git config --global user.name "$(ask 'Git name')"
  git config --global user.email >/dev/null ||
    git config --global user.email "$(ask 'Personal git email')"
}

##
# Fills ACTIVE_PROFILES from PROFILES_FILE after applying the --add/--remove
# arguments. Without the file (first run) it asks for each profile, so later
# runs stay unattended.
choose_profiles() {
  local p
  if [ ! -f "$PROFILES_FILE" ]; then
    mkdir -p "$(dirname "$PROFILES_FILE")"
    : >"$PROFILES_FILE"
    for p in "${PROFILES[@]}"; do
      [[ "$(ask "Set up the $p profile on this machine? [y/N]")" =~ ^[yY] ]] && echo "$p" >>"$PROFILES_FILE"
    done
  fi
  for p in "${ADD_PROFILES[@]}"; do
    grep -qx "$p" "$PROFILES_FILE" || echo "$p" >>"$PROFILES_FILE"
  done
  for p in "${REMOVE_PROFILES[@]}"; do
    sed -i "/^$p\$/d" "$PROFILES_FILE"
  done
  mapfile -t ACTIVE_PROFILES <"$PROFILES_FILE"
  echo "Profiles: ${ACTIVE_PROFILES[*]:-none} (stored in $PROFILES_FILE)"
}

install_apt_packages() {
  step "apt packages"
  sudo apt-get update
  sudo apt-get install -y "${APT_PACKAGES[@]}"
  if dpkg -l 'libreoffice*' 2>/dev/null | grep -q '^ii'; then
    sudo apt-get purge -y 'libreoffice*'
    sudo apt-get autoremove -y
  fi
  mkdir -p "$HOME/.local/bin"
  ln -sf /usr/bin/fdfind "$HOME/.local/bin/fd"
}

setup_auth() {
  step "ssh key + GitHub/GitLab auth"
  [ -f "$HOME/.ssh/id_ed25519" ] ||
    ssh-keygen -t ed25519 -C "$(git config --global user.email)" -f "$HOME/.ssh/id_ed25519"
  gh auth status &>/dev/null || gh auth login --git-protocol ssh
}

install_dotfiles() {
  step "dotfiles"
  local dotfiles=(git --git-dir="$HOME/.dotfiles" --work-tree="$HOME")
  if [ ! -d "$HOME/.dotfiles" ]; then
    git clone --bare https://github.com/glklimmer/dotfiles.git "$HOME/.dotfiles"
    mkdir -p "$HOME/.dotfiles-backup"
    "${dotfiles[@]}" ls-files | while read -r file; do
      if [ -e "$HOME/$file" ]; then
        mkdir -p "$HOME/.dotfiles-backup/$(dirname "$file")"
        mv "$HOME/$file" "$HOME/.dotfiles-backup/$file"
      fi
    done
    "${dotfiles[@]}" checkout
  fi
  "${dotfiles[@]}" config status.showUntrackedFiles no
}

##
# Writes the COSMIC top panel's applet layout, which is left out of the dotfiles
# because it differs per machine: the Bluetooth applet is optional. Runs only
# while the file is missing, so a re-run keeps the layout a machine already has.
# Applet changes made in COSMIC Settings belong in PANEL_APPLETS_LEFT and
# PANEL_APPLETS_RIGHT as well, or a new machine won't get them.
setup_cosmic_panel() {
  step "cosmic panel"
  local file="$HOME/.config/cosmic/com.system76.CosmicPanel.Panel/v1/plugins_wings"
  [ -f "$file" ] && return
  local right=() applet skip=
  case "$(ask 'Show the Bluetooth applet in the COSMIC panel? [Y/n]')" in
    [nN]*) skip=com.system76.CosmicAppletBluetooth ;;
  esac
  for applet in "${PANEL_APPLETS_RIGHT[@]}"; do
    [ "$applet" = "$skip" ] || right+=("$applet")
  done
  mkdir -p "$(dirname "$file")"
  {
    echo 'Some((['
    for applet in "${PANEL_APPLETS_LEFT[@]}"; do printf '    "%s",\n' "$applet"; done
    echo '], ['
    for applet in "${right[@]}"; do printf '    "%s",\n' "$applet"; done
    printf ']))'
  } >"$file"
}

##
# Keeps Bluetooth controllers powered off when bluetoothd starts, so the
# machine boots with Bluetooth off until it is switched on in the panel.
# BlueZ 5.72 reads no drop-in directory, so main.conf itself is edited.
disable_bluetooth_autoenable() {
  step "bluetooth off at boot"
  grep -qx 'AutoEnable=false' /etc/bluetooth/main.conf && return
  sudo sed -i 's/^#\?AutoEnable=.*/AutoEnable=false/' /etc/bluetooth/main.conf
}

install_zsh() {
  step "zsh + oh-my-zsh"
  if [ ! -d "$HOME/.oh-my-zsh" ]; then
    RUNZSH=no CHSH=no KEEP_ZSHRC=yes \
      sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
  fi
  local plugin
  for plugin in "${ZSH_PLUGINS[@]}"; do
    clone "$plugin" "$HOME/.oh-my-zsh/custom/plugins/$(basename "$plugin")"
  done
  if [ "$(getent passwd "$USER" | cut -d: -f7)" != "$(command -v zsh)" ]; then
    sudo chsh -s "$(command -v zsh)" "$USER"
  fi
}

install_mise() {
  step "mise + global tools"
  [ -x "$HOME/.local/bin/mise" ] || curl -fsSL https://mise.run | sh
  "$HOME/.local/bin/mise" install
}

install_rust() {
  step "rust + alacritty + sccache"
  has rustup || curl -fsSL https://sh.rustup.rs | sh -s -- -y --no-modify-path
  # shellcheck source=/dev/null
  . "$HOME/.cargo/env"
  has sccache || RUSTC_WRAPPER= cargo install sccache --locked
  has alacritty || cargo install alacritty
  install_alacritty_desktop_entry
}

# `cargo install` ships only the binary, so the launcher shows the window as
# "unknown" without an icon. Installs the desktop entry and icon from the
# crate sources, with an absolute Exec path because the graphical session's
# PATH need not include ~/.cargo/bin.
install_alacritty_desktop_entry() {
  local src
  src="$(ls -d "$HOME"/.cargo/registry/src/*/alacritty-[0-9]* 2>/dev/null | sort -V | tail -n1)"
  [ -n "$src" ] || return 0
  local apps="$HOME/.local/share/applications"
  local icons="$HOME/.local/share/icons/hicolor/scalable/apps"
  mkdir -p "$apps" "$icons"
  sed "s|^\(Try\)\?Exec=alacritty|\1Exec=$HOME/.cargo/bin/alacritty|" \
    "$src/extra/linux/Alacritty.desktop" >"$apps/Alacritty.desktop"
  cp "$src/extra/logo/alacritty-term.svg" "$icons/Alacritty.svg"
  update-desktop-database "$apps" 2>/dev/null || true
}

install_neovim() {
  step "neovim"
  if [ ! -x /opt/nvim/bin/nvim ]; then
    local tmp
    tmp="$(mktemp -d)"
    curl -fsSL https://github.com/neovim/neovim/releases/latest/download/nvim-linux-x86_64.tar.gz |
      tar -xz -C "$tmp"
    sudo rm -rf /opt/nvim
    sudo mv "$tmp/nvim-linux-x86_64" /opt/nvim
    rm -rf "$tmp"
  fi
  if [ ! -d "$HOME/.config/nvim" ]; then
    git clone https://github.com/glklimmer/nvim-config.git "$HOME/.config/nvim"
    git -C "$HOME/.config/nvim" remote set-url origin git@github.com:glklimmer/nvim-config.git
  fi
}

install_tmux_plugins() {
  step "tmux plugins"
  clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
  TMUX_PLUGIN_MANAGER_PATH="$HOME/.config/tmux/plugins/" "$HOME/.tmux/plugins/tpm/bin/install_plugins"
}

install_flatpaks() {
  flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
  flatpak install --user -y --noninteractive flathub "$@"
}

install_tridactyl_native() {
  step "tridactyl native messenger"
  [ -x "$HOME/.local/share/tridactyl/native_main" ] ||
    curl -fsSL https://raw.githubusercontent.com/tridactyl/native_messenger/master/installers/install.sh |
    sh -s -- "$TRIDACTYL_NATIVE_VERSION"
}

install_claude_plugins() {
  local claude="$HOME/.local/bin/claude" plugin
  for plugin in "$@"; do
    "$claude" plugin list | grep -q "$plugin" || "$claude" plugin install "$plugin"
  done
}

install_claude() {
  step "claude code"
  [ -x "$HOME/.local/bin/claude" ] || curl -fsSL https://claude.ai/install.sh | bash
  local claude="$HOME/.local/bin/claude"
  "$claude" plugin marketplace list | grep -q tmux-claude-status ||
    "$claude" plugin marketplace add "$HOME/.config/tmux/plugins/tmux-claude-status"
  install_claude_plugins "${CLAUDE_PLUGINS[@]}"
  "$claude" mcp get chrome-devtools &>/dev/null ||
    "$claude" mcp add -s user chrome-devtools -- "$HOME/.local/share/mise/shims/npx" --prefix "$HOME" -y chrome-devtools-mcp@latest \
      --isolated --headless --viewport 1280x720 --no-usage-statistics \
      --executable-path "$HOME/.local/share/flatpak/exports/bin/com.google.Chrome"
}

##
# Boot splash themes from adi1090x/plymouth-themes, which also draw the LUKS
# password prompt. Only the chosen theme folders are fetched (via the contents
# API) because the full repo is several hundred MB of preview GIFs. Pixels is
# made the active theme; switch with `sudo update-alternatives --config
# default.plymouth` followed by `sudo update-initramfs -u`.
install_plymouth_themes() {
  step "plymouth themes"
  local themes=(pack_3/pixels pack_1/circuit) changed= path name dir url
  for path in "${themes[@]}"; do
    name="${path#*/}" dir="/usr/share/plymouth/themes/${path#*/}"
    [ -f "$dir/$name.plymouth" ] && continue
    sudo install -d -m 755 "$dir"
    curl -fsSL "https://api.github.com/repos/adi1090x/plymouth-themes/contents/$path" |
      python3 -I -c 'import sys, json; print("\n".join(f["download_url"] for f in json.load(sys.stdin)))' |
      while read -r url; do curl -fsSL "$url" | sudo tee "$dir/${url##*/}" >/dev/null; done
    sudo update-alternatives --install /usr/share/plymouth/themes/default.plymouth default.plymouth \
      "$dir/$name.plymouth" 100
    changed=1
  done
  [ -n "$changed" ] || return 0
  sudo update-alternatives --set default.plymouth /usr/share/plymouth/themes/pixels/pixels.plymouth
  sudo update-initramfs -u
}

install_wayvnc() {
  has wayvnc && return
  local tmp
  tmp="$(mktemp -d)"
  git clone -q --depth 1 --branch "$AML_VERSION" https://github.com/any1/aml.git "$tmp/aml"
  git clone -q --depth 1 --branch "$NEATVNC_VERSION" https://github.com/any1/neatvnc.git "$tmp/neatvnc"
  git clone -q --depth 1 --branch "$WAYVNC_VERSION" https://github.com/any1/wayvnc.git "$tmp/wayvnc"
  mkdir -p "$tmp/wayvnc/subprojects"
  ln -s ../../aml "$tmp/wayvnc/subprojects/aml"
  ln -s ../../neatvnc "$tmp/wayvnc/subprojects/neatvnc"
  meson setup "$tmp/build" "$tmp/wayvnc" --prefix=/usr/local --buildtype=release \
    -Dman-pages=disabled -Ddefault_library=static
  ninja -C "$tmp/build"
  sudo ninja -C "$tmp/build" install
  rm -rf "$tmp"
}

##
# Shell commands that install the root helper of `dock` copied to /tmp/<name>,
# plus the sudoers rule letting the current user run exactly that helper without
# a password. Returned as text so the PC can run them in the same SSH session as
# its apt install, which keeps it to one password prompt.
root_helper_install() {
  local name="$1"
  local rule="%s ALL=(root) NOPASSWD: /usr/local/sbin/$name"
  printf '%s\n' "sudo install -o root -g root -m 755 /tmp/$name /usr/local/sbin/$name" \
    "printf '$rule\\n' \"\$USER\" >/tmp/$name.sudoers" \
    "sudo visudo -cf /tmp/$name.sudoers" \
    "sudo install -o root -g root -m 440 /tmp/$name.sudoers /etc/sudoers.d/$name" \
    "rm /tmp/$name /tmp/$name.sudoers"
}

##
# Command creating the "dock" NetworkManager connection on the machine's first
# Ethernet port: DHCP as usual, plus a fixed address for a direct cable between
# laptop and PC. DHCP never times out, so on the direct cable (no DHCP server)
# the connection stays up with just the fixed address, and on any other network
# the port works normally.
dock_cable_connection() {
  printf '%s' "nmcli connection add type ethernet con-name dock" \
    " ifname \"\$(nmcli -t -f DEVICE,TYPE device | awk -F: '\$2 == \"ethernet\" { print \$1; exit }')\"" \
    " ipv4.method auto ipv4.addresses $1 ipv4.may-fail yes ipv4.dhcp-timeout infinity ipv6.method link-local" \
    " connection.autoconnect yes connection.autoconnect-priority 10"
}

##
# The PC's QCA6174 (ath10k) firmware times out when Wi-Fi power saving is
# toggled at runtime, so dock never toggles it there; it is disabled for good
# on the active Wi-Fi connection instead (2 = disable).
dock_wifi_powersave_off() {
  printf '%s' "nmcli -t -f NAME,TYPE connection show --active | awk -F: '\$2 == \"802-11-wireless\" { print \$1 }'" \
    " | while read -r c; do sudo nmcli connection modify \"\$c\" wifi.powersave 2; done"
}

dock_wifi_powersave_check() {
  printf '%s' "! nmcli -t -f NAME,TYPE connection show --active | awk -F: '\$2 == \"802-11-wireless\" { print \$1 }'" \
    " | while read -r c; do nmcli -g 802-11-wireless.powersave connection show \"\$c\"; done | grep -vqx disable"
}

##
# Keeps the PC's onboard card on pro-audio, which WirePlumber remembers once
# set, and names its two outputs (~/scripts/dock/pc-audio.lua). Normal profiles
# offer only the headphones or the speakers, which breaks both the dock and the
# panel's output switcher. Pro-audio leaves the mixer alone, so the digital
# output is unmuted once here; ALSA keeps that state across reboots.
# The Sound Output Device Chooser extension also lists the card's ports from
# the normal profiles; picking one leaves pro-audio, and the extension then
# undoes the dock's switch back, so those ports are hidden in its settings.
dock_pc_audio() {
  local rule=.config/wireplumber/main.lua.d/51-dock-audio.lua changed=
  if ! ssh "$1" "cmp -s - ~/$rule" <"$HOME/scripts/dock/pc-audio.lua"; then
    ssh "$1" "mkdir -p ~/${rule%/*} && cat >~/$rule" <"$HOME/scripts/dock/pc-audio.lua"
    changed=1
  fi
  ssh "$1" bash -s -- "$changed" <<'EOF'
set -e
card=alsa_card.pci-0000_00_1f.3
[ -z "$1" ] || systemctl --user restart wireplumber
for _ in $(seq 25); do pactl list short cards | grep -q "	$card	" && break; sleep 0.2; done
pactl list cards | awk -v card="$card" '$1 == "Name:" { found = ($2 == card) } found && /Active Profile:/ { print $3; exit }' |
  grep -qx pro-audio || pactl set-card-profile "$card" pro-audio
ext=~/.local/share/gnome-shell/extensions/sound-output-device-chooser@kgshank.net
if [ -d "$ext/schemas" ]; then
  sdc=(gsettings --schemadir "$ext/schemas")
  key=(org.gnome.shell.extensions.sound-output-device-chooser ports-settings)
  ports=$("${sdc[@]}" get "${key[@]}" | python3 -c '
import ast, json, sys
card, desc = sys.argv[1], "Built-in Audio"
settings = json.loads(ast.literal_eval(sys.stdin.read()) or "{\"version\":3,\"ports\":[]}")
hidden = {"analog-output-lineout": "Line Out", "analog-output-headphones": "Headphones",
          "iec958-stereo-output": "Digital Output (S/PDIF)"}
ports = [p for p in settings["ports"] if not (p["card_name"] == card and p["name"] in hidden)]
ports += [{"human_name": human, "name": name, "display_option": 2, "card_name": card,
           "card_description": desc, "display_name": f"{human} - {desc}"} for name, human in hidden.items()]
settings["ports"] = ports
print("\x27" + json.dumps(settings).replace("\\", "\\\\").replace("\x27", "\\\x27") + "\x27")
' "$card")
  "${sdc[@]}" set "${key[@]}" "$ports"
fi
amixer -q -c "$(pactl list cards | awk -v card="$card" '$1 == "Name:" { found = ($2 == card) } found && $1 == "api.alsa.card" { gsub(/"/, "", $3); print $3; exit }')" sset IEC958 on
EOF
}

##
# Optional: docks this laptop to a PC over the network (see ~/scripts/dock/dock).
# Answering the prompt once stores DOCK_HOST in ~/.zshrc.local, so re-runs keep
# the machine set up without asking again.
setup_dock() {
  step "dock (use the PC's monitors, audio, mouse and webcam over the network)"
  local host
  if ! grep -q '^export DOCK_HOST=' "$HOME/.zshrc.local" 2>/dev/null; then
    [[ "$(ask 'Set up dock on this machine? [y/N]')" =~ ^[yY] ]] || return 0
    host="$(ask 'PC to dock to, as user@host')"
    ensure_private "$HOME/.zshrc.local"
    printf '\n# dock\nexport DOCK_HOST=%s\n' "$host" >>"$HOME/.zshrc.local"
  fi
  host="$(sed -n 's/^export DOCK_HOST=//p' "$HOME/.zshrc.local")"
  sudo apt-get install -y "${DOCK_APT_PACKAGES[@]}"
  sudo apt-get install -y "linux-tools-$(uname -r)" ||
    echo "No linux-tools for $(uname -r); dock-root falls back to another installed usbip."
  install_wayvnc
  if ! cmp -s "$HOME/scripts/dock/dock-root" /usr/local/sbin/dock-root || [ ! -f /etc/sudoers.d/dock-root ]; then
    cp "$HOME/scripts/dock/dock-root" /tmp/dock-root
    bash -ec "$(root_helper_install dock-root)"
  fi
  nmcli -t -f NAME connection show | grep -qx dock || dock_cable_connection 10.42.0.1/24 | bash -e
  if ! ssh -o BatchMode=yes "$host" true 2>/dev/null; then
    echo "Cannot reach $host without a password; run ssh-copy-id $host and re-run."
    return
  fi
  dock_pc_audio "$host"
  ssh "$host" "cmp -s - /usr/local/sbin/dock-usb && test -f /etc/sudoers.d/dock-usb &&
    nmcli -t -f NAME connection show | grep -qx dock && $(dock_wifi_powersave_check)" <"$HOME/scripts/dock/dock-usb" && return
  scp -q "$HOME/scripts/dock/dock-usb" "$host:/tmp/dock-usb"
  local remote
  remote="set -e
sudo apt-get install -y ${DOCK_PC_PACKAGES[*]}
$(root_helper_install dock-usb)
nmcli -t -f NAME connection show | grep -qx dock || sudo $(dock_cable_connection 10.42.0.2/24)
sudo nmcli connection up dock 2>/dev/null || true
$(dock_wifi_powersave_off)"
  ssh -t "$host" bash -c "$(printf '%q' "$remote")"
}

enable_services() {
  step "systemd user services"
  systemctl --user daemon-reload
  systemctl --user enable --now theme-sync.service spotify-volume.service power-profile.service
}

##
# Asks for the sudo password once and keeps the credential fresh until the
# script exits, since long steps (cargo builds, mise installs) outlast sudo's
# 15 minute timeout and would otherwise prompt again midway.
keep_sudo_alive() {
  sudo -v
  while kill -0 "$$" 2>/dev/null; do
    sudo -n true
    sleep 60
  done &
}

ADD_PROFILES=() REMOVE_PROFILES=()
while [ $# -gt 0 ]; do
  case "$1" in
    --add | --remove)
      [ $# -ge 2 ] && [[ " ${PROFILES[*]} " == *" $2 "* ]] || usage
      if [ "$1" = --add ]; then ADD_PROFILES+=("$2"); else REMOVE_PROFILES+=("$2"); fi
      shift 2
      ;;
    *) usage ;;
  esac
done

choose_profiles
keep_sudo_alive
setup_git_identity
install_apt_packages
setup_auth
install_dotfiles
setup_cosmic_panel
disable_bluetooth_autoenable
install_zsh
install_mise
install_rust
install_neovim
install_tmux_plugins
step "flatpaks"
install_flatpaks "${FLATPAKS[@]}"
install_tridactyl_native
step "machine-local tridactyl commands (~/.config/tridactyl/tridactylrc.local)"
ensure_private "$HOME/.config/tridactyl/tridactylrc.local"
install_claude
install_plymouth_themes
setup_dock
enable_services
for profile in "${ACTIVE_PROFILES[@]}"; do
  # shellcheck source=/dev/null
  . "$HOME/scripts/$profile/bootstrap.sh"
  "setup_$profile"
done

step "done"
printf 'Next: %s\n' "${NEXT_STEPS[@]}"
