#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat >&2 <<EOF
Usage: $(basename "$0")

Installs every tool and program this machine needs (Pop!_OS / Ubuntu) and
wires up the dotfiles. Safe to re-run: each step skips what is already there.

Fresh machine:
    bash <(curl -fsSL https://raw.githubusercontent.com/glklimmer/dotfiles/master/scripts/bootstrap)
EOF
  exit 1
}

[ $# -eq 0 ] || usage

APT_PACKAGES=(
  zsh tmux curl unzip p7zip-full build-essential
  ripgrep fd-find fzf jq xclip wl-clipboard htop
  ffmpegthumbnailer imagemagick poppler-utils
  gh glab
  # alacritty build deps
  cmake g++ pkg-config libfontconfig1-dev libxcb-xfixes0-dev libxkbcommon-dev python3
  # denteo
  postgresql postgresql-16-pgvector libpq-dev libvips libicu-dev libyaml-dev qpdf qrencode ffmpeg dcmtk
)

DOCK_APT_PACKAGES=(
  iw xxd
  # wayvnc build deps
  meson ninja-build libpixman-1-dev libdrm-dev libgbm-dev libwayland-dev wayland-protocols
  libjansson-dev libturbojpeg0-dev libgnutls28-dev nettle-dev libgmp-dev zlib1g-dev libpam0g-dev
)

DOCK_PC_PACKAGES=(tigervnc-viewer iw linux-tools-generic)

WAYVNC_VERSION=v0.10.2
NEATVNC_VERSION=v1.0.3
AML_VERSION=v1.0.0

FLATPAKS=(com.google.Chrome com.slack.Slack com.spotify.Client)

ZSH_PLUGINS=(
  https://github.com/zsh-users/zsh-autosuggestions
  https://github.com/zsh-users/zsh-syntax-highlighting
  https://github.com/jeffreytse/zsh-vi-mode
)

TRIDACTYL_NATIVE_VERSION=1.25.1

CLAUDE_PLUGINS=(
  slack@claude-plugins-official
  sentry-cli@claude-plugins-official
  tmux-claude-status@tmux-claude-status
)

GITLAB_HOST=git.panter.ch

step() { printf '\n\033[1;34m==> %s\033[0m\n' "$*"; }
has() { command -v "$1" &>/dev/null; }

ask() {
  local reply
  read -rp "$1: " reply
  printf '%s' "$reply"
}

ask_secret() {
  local reply
  read -rsp "$1: " reply
  echo >&2
  printf '%s' "$reply"
}

clone() {
  local url="$1" dir="$2"
  [ -d "$dir" ] || git clone --depth 1 "$url" "$dir"
}

setup_git_identity() {
  step "git identity"
  git config --global user.name >/dev/null ||
    git config --global user.name "$(ask 'Git name')"
  git config --global user.email >/dev/null ||
    git config --global user.email "$(ask 'Personal git email')"
  if [ ! -f "$HOME/.gitconfig-denteo" ]; then
    git config --global includeIf."gitdir:~/denteo/".path "~/.gitconfig-denteo"
    git config -f "$HOME/.gitconfig-denteo" user.name "$(git config --global user.name)"
    git config -f "$HOME/.gitconfig-denteo" user.email "$(ask 'Denteo git email')"
  fi
}

setup_local_env() {
  step "machine-local secrets (~/.zshrc.local)"
  [ -f "$HOME/.zshrc.local" ] && return
  local sentry_url sentry_token
  sentry_url="$(ask 'Sentry URL')"
  sentry_token="$(ask_secret 'Sentry auth token')"
  install -m 600 /dev/null "$HOME/.zshrc.local"
  cat >"$HOME/.zshrc.local" <<EOF
# Sentry CLI
export SENTRY_URL=$sentry_url
export SENTRY_AUTH_TOKEN=$sentry_token
export SENTRY_FORCE_ENV_TOKEN=1
EOF
}

install_apt_packages() {
  step "apt packages"
  sudo apt-get update
  sudo apt-get install -y "${APT_PACKAGES[@]}"
  if dpkg -l 'libreoffice*' 2>/dev/null | grep -q '^ii'; then
    sudo apt-get purge -y 'libreoffice*'
    sudo apt-get autoremove -y
  fi
  mkdir -p "$HOME/.local/bin"
  ln -sf /usr/bin/fdfind "$HOME/.local/bin/fd"
}

setup_auth() {
  step "ssh key + GitHub/GitLab auth"
  [ -f "$HOME/.ssh/id_ed25519" ] ||
    ssh-keygen -t ed25519 -C "$(git config --global user.email)" -f "$HOME/.ssh/id_ed25519"
  gh auth status &>/dev/null || gh auth login --git-protocol ssh
  if ! glab auth status --hostname "$GITLAB_HOST" &>/dev/null; then
    glab auth login --hostname "$GITLAB_HOST"
    glab ssh-key add "$HOME/.ssh/id_ed25519.pub" -t "$(hostname)" --hostname "$GITLAB_HOST" || true
  fi
}

install_dotfiles() {
  step "dotfiles"
  local dotfiles=(git --git-dir="$HOME/.dotfiles" --work-tree="$HOME")
  if [ ! -d "$HOME/.dotfiles" ]; then
    git clone --bare https://github.com/glklimmer/dotfiles.git "$HOME/.dotfiles"
    mkdir -p "$HOME/.dotfiles-backup"
    "${dotfiles[@]}" ls-files | while read -r file; do
      if [ -e "$HOME/$file" ]; then
        mkdir -p "$HOME/.dotfiles-backup/$(dirname "$file")"
        mv "$HOME/$file" "$HOME/.dotfiles-backup/$file"
      fi
    done
    "${dotfiles[@]}" checkout
  fi
  "${dotfiles[@]}" config status.showUntrackedFiles no
}

install_zsh() {
  step "zsh + oh-my-zsh"
  if [ ! -d "$HOME/.oh-my-zsh" ]; then
    RUNZSH=no CHSH=no KEEP_ZSHRC=yes \
      sh -c "$(curl -fsSL https://raw.githubusercontent.com/ohmyzsh/ohmyzsh/master/tools/install.sh)"
  fi
  local plugin
  for plugin in "${ZSH_PLUGINS[@]}"; do
    clone "$plugin" "$HOME/.oh-my-zsh/custom/plugins/$(basename "$plugin")"
  done
  if [ "$(getent passwd "$USER" | cut -d: -f7)" != "$(command -v zsh)" ]; then
    sudo chsh -s "$(command -v zsh)" "$USER"
  fi
}

install_mise() {
  step "mise + global tools"
  [ -x "$HOME/.local/bin/mise" ] || curl -fsSL https://mise.run | sh
  "$HOME/.local/bin/mise" install
}

install_rust() {
  step "rust + alacritty"
  has rustup || curl -fsSL https://sh.rustup.rs | sh -s -- -y --no-modify-path
  # shellcheck source=/dev/null
  . "$HOME/.cargo/env"
  has alacritty || cargo install alacritty
}

install_neovim() {
  step "neovim"
  if [ ! -x /opt/nvim/bin/nvim ]; then
    local tmp
    tmp="$(mktemp -d)"
    curl -fsSL https://github.com/neovim/neovim/releases/latest/download/nvim-linux-x86_64.tar.gz |
      tar -xz -C "$tmp"
    sudo rm -rf /opt/nvim
    sudo mv "$tmp/nvim-linux-x86_64" /opt/nvim
    rm -rf "$tmp"
  fi
  if [ ! -d "$HOME/.config/nvim" ]; then
    git clone https://github.com/glklimmer/nvim-config.git "$HOME/.config/nvim"
    git -C "$HOME/.config/nvim" remote set-url origin git@github.com:glklimmer/nvim-config.git
  fi
}

install_tmux_plugins() {
  step "tmux plugins"
  clone https://github.com/tmux-plugins/tpm "$HOME/.tmux/plugins/tpm"
  TMUX_PLUGIN_MANAGER_PATH="$HOME/.config/tmux/plugins/" "$HOME/.tmux/plugins/tpm/bin/install_plugins"
}

install_flatpaks() {
  step "flatpaks"
  flatpak remote-add --user --if-not-exists flathub https://dl.flathub.org/repo/flathub.flatpakrepo
  flatpak install --user -y --noninteractive flathub "${FLATPAKS[@]}"
}

install_tridactyl_native() {
  step "tridactyl native messenger"
  [ -x "$HOME/.local/share/tridactyl/native_main" ] ||
    curl -fsSL https://raw.githubusercontent.com/tridactyl/native_messenger/master/installers/install.sh |
    sh -s -- "$TRIDACTYL_NATIVE_VERSION"
}

setup_tridactyl_local() {
  step "machine-local tridactyl commands (~/.config/tridactyl/tridactylrc.local)"
  local rc="$HOME/.config/tridactyl/tridactylrc.local"
  [ -f "$rc" ] && return
  local password
  password="$(ask_secret 'Denteo dev denteo_admin password')"
  install -m 600 /dev/null "$rc"
  printf 'command login js -d€ -r login.js€ %s\n' "$password" >"$rc"
}

install_claude() {
  step "claude code"
  [ -x "$HOME/.local/bin/claude" ] || curl -fsSL https://claude.ai/install.sh | bash
  local claude="$HOME/.local/bin/claude" plugin
  "$claude" plugin marketplace list | grep -q tmux-claude-status ||
    "$claude" plugin marketplace add "$HOME/.config/tmux/plugins/tmux-claude-status"
  for plugin in "${CLAUDE_PLUGINS[@]}"; do
    "$claude" plugin list | grep -q "$plugin" || "$claude" plugin install "$plugin"
  done
  "$claude" mcp get chrome-devtools &>/dev/null ||
    "$claude" mcp add -s user chrome-devtools -- "$HOME/.local/share/mise/shims/npx" -y chrome-devtools-mcp@latest \
      --isolated --headless --viewport 1280x720 --no-usage-statistics \
      --executable-path "$HOME/.local/share/flatpak/exports/bin/com.google.Chrome"
}

install_wayvnc() {
  has wayvnc && return
  local tmp
  tmp="$(mktemp -d)"
  git clone -q --depth 1 --branch "$AML_VERSION" https://github.com/any1/aml.git "$tmp/aml"
  git clone -q --depth 1 --branch "$NEATVNC_VERSION" https://github.com/any1/neatvnc.git "$tmp/neatvnc"
  git clone -q --depth 1 --branch "$WAYVNC_VERSION" https://github.com/any1/wayvnc.git "$tmp/wayvnc"
  mkdir -p "$tmp/wayvnc/subprojects"
  ln -s ../../aml "$tmp/wayvnc/subprojects/aml"
  ln -s ../../neatvnc "$tmp/wayvnc/subprojects/neatvnc"
  meson setup "$tmp/build" "$tmp/wayvnc" --prefix=/usr/local --buildtype=release \
    -Dman-pages=disabled -Ddefault_library=static
  ninja -C "$tmp/build"
  sudo ninja -C "$tmp/build" install
  rm -rf "$tmp"
}

##
# Shell commands that install the root helper of `dock` copied to /tmp/<name>,
# plus the sudoers rule letting the current user run exactly that helper without
# a password. Returned as text so the PC can run them in the same SSH session as
# its apt install, which keeps it to one password prompt.
root_helper_install() {
  local name="$1"
  local rule="%s ALL=(root) NOPASSWD: /usr/local/sbin/$name"
  printf '%s\n' "sudo install -o root -g root -m 755 /tmp/$name /usr/local/sbin/$name" \
    "printf '$rule\\n' \"\$USER\" >/tmp/$name.sudoers" \
    "sudo visudo -cf /tmp/$name.sudoers" \
    "sudo install -o root -g root -m 440 /tmp/$name.sudoers /etc/sudoers.d/$name" \
    "rm /tmp/$name /tmp/$name.sudoers"
}

##
# Command creating the "dock" NetworkManager connection on the machine's first
# Ethernet port: DHCP as usual, plus a fixed address for a direct cable between
# laptop and PC. DHCP never times out, so on the direct cable (no DHCP server)
# the connection stays up with just the fixed address, and on any other network
# the port works normally.
dock_cable_connection() {
  printf '%s' "nmcli connection add type ethernet con-name dock" \
    " ifname \"\$(nmcli -t -f DEVICE,TYPE device | awk -F: '\$2 == \"ethernet\" { print \$1; exit }')\"" \
    " ipv4.method auto ipv4.addresses $1 ipv4.may-fail yes ipv4.dhcp-timeout infinity ipv6.method link-local" \
    " connection.autoconnect yes connection.autoconnect-priority 10"
}

##
# The PC's QCA6174 (ath10k) firmware times out when Wi-Fi power saving is
# toggled at runtime, so dock never toggles it there; it is disabled for good
# on the active Wi-Fi connection instead (2 = disable).
dock_wifi_powersave_off() {
  printf '%s' "nmcli -t -f NAME,TYPE connection show --active | awk -F: '\$2 == \"802-11-wireless\" { print \$1 }'" \
    " | while read -r c; do sudo nmcli connection modify \"\$c\" wifi.powersave 2; done"
}

dock_wifi_powersave_check() {
  printf '%s' "! nmcli -t -f NAME,TYPE connection show --active | awk -F: '\$2 == \"802-11-wireless\" { print \$1 }'" \
    " | while read -r c; do nmcli -g 802-11-wireless.powersave connection show \"\$c\"; done | grep -vqx disable"
}

##
# Optional: docks this laptop to a PC over the network (see ~/scripts/dock/dock).
# Answering the prompt once stores DOCK_HOST in ~/.zshrc.local, so re-runs keep
# the machine set up without asking again.
setup_dock() {
  step "dock (use the PC's monitors, audio, mouse and webcam over the network)"
  local host
  if ! grep -q '^export DOCK_HOST=' "$HOME/.zshrc.local" 2>/dev/null; then
    [[ "$(ask 'Set up dock on this machine? [y/N]')" =~ ^[yY] ]] || return 0
    host="$(ask 'PC to dock to, as user@host')"
    printf '\n# dock\nexport DOCK_HOST=%s\n' "$host" >>"$HOME/.zshrc.local"
  fi
  host="$(sed -n 's/^export DOCK_HOST=//p' "$HOME/.zshrc.local")"
  sudo apt-get install -y "${DOCK_APT_PACKAGES[@]}"
  sudo apt-get install -y "linux-tools-$(uname -r)" ||
    echo "No linux-tools for $(uname -r); dock-root falls back to another installed usbip."
  install_wayvnc
  if ! cmp -s "$HOME/scripts/dock/dock-root" /usr/local/sbin/dock-root || [ ! -f /etc/sudoers.d/dock-root ]; then
    cp "$HOME/scripts/dock/dock-root" /tmp/dock-root
    bash -ec "$(root_helper_install dock-root)"
  fi
  nmcli -t -f NAME connection show | grep -qx dock || dock_cable_connection 10.42.0.1/24 | bash -e
  if ! ssh -o BatchMode=yes "$host" true 2>/dev/null; then
    echo "Cannot reach $host without a password; run ssh-copy-id $host and re-run."
    return
  fi
  ssh "$host" "cmp -s - /usr/local/sbin/dock-usb && test -f /etc/sudoers.d/dock-usb &&
    nmcli -t -f NAME connection show | grep -qx dock && $(dock_wifi_powersave_check)" <"$HOME/scripts/dock/dock-usb" && return
  scp -q "$HOME/scripts/dock/dock-usb" "$host:/tmp/dock-usb"
  local remote
  remote="set -e
sudo apt-get install -y ${DOCK_PC_PACKAGES[*]}
$(root_helper_install dock-usb)
nmcli -t -f NAME connection show | grep -qx dock || sudo $(dock_cable_connection 10.42.0.2/24)
sudo nmcli connection up dock 2>/dev/null || true
$(dock_wifi_powersave_off)"
  ssh -t "$host" bash -c "$(printf '%q' "$remote")"
}

enable_services() {
  step "systemd user services"
  systemctl --user daemon-reload
  systemctl --user enable --now theme-sync.service
}

setup_denteo() {
  step "denteo"
  sudo -u postgres psql -tAc "SELECT 1 FROM pg_roles WHERE rolname = '$USER'" | grep -q 1 ||
    sudo -u postgres createuser --superuser "$USER"

  mkdir -p "$HOME/denteo"
  local repo
  for repo in panter/dental denteo/dhc; do
    local dir="$HOME/denteo/$(basename "$repo")"
    [ -d "$dir" ] || git clone "git@git.panter.ch:$repo.git" "$dir" ||
      echo "Could not clone $repo — add your SSH key to git.panter.ch and re-run."
  done

  if [ -d "$HOME/denteo/dental" ]; then
    cd "$HOME/denteo/dental"
    "$HOME/.local/bin/mise" trust
    "$HOME/.local/bin/mise" install
    "$HOME/.local/bin/mise" exec -- bun install
    "$HOME/.local/bin/mise" exec -- bunx playwright install --with-deps chromium
    cd - >/dev/null
  fi
}

##
# Asks for the sudo password once and keeps the credential fresh until the
# script exits, since long steps (cargo builds, mise installs) outlast sudo's
# 15 minute timeout and would otherwise prompt again midway.
keep_sudo_alive() {
  sudo -v
  while kill -0 "$$" 2>/dev/null; do
    sudo -n true
    sleep 60
  done &
}

keep_sudo_alive
setup_git_identity
setup_local_env
install_apt_packages
setup_auth
install_dotfiles
install_zsh
install_mise
install_rust
install_neovim
install_tmux_plugins
install_flatpaks
install_tridactyl_native
setup_tridactyl_local
install_claude
setup_dock
enable_services
setup_denteo

step "done"
echo "Next: log out and back in (zsh), then run bin/setup in ~/denteo/dental."
